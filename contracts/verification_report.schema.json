{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-warehouse-workflow/contracts/verification_report.schema.json",
  "title": "现网验证报告（P6 交付物，H3 放行依据）",
  "description": "把 DQ 规则拿到现网库跑一遍，留下可复查的证据。没有这份报告，G5/H3 不许放行。",
  "type": "object",
  "required": [
    "run_id",
    "stage",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{2}$"
    },
    "stage": {
      "enum": [
        "P6"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "generated_at",
        "environment",
        "checks",
        "summary",
        "signoff"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{8}-[0-9]{2}$"
        },
        "generated_at": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "engine"
          ],
          "properties": {
            "mode": {
              "enum": [
                "offline",
                "online"
              ]
            },
            "engine": {
              "enum": [
                "hive",
                "spark",
                "presto",
                "other",
                "none"
              ]
            },
            "target": {
              "type": "string"
            },
            "queried_at": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rule_id",
              "sql",
              "expect",
              "verdict"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^V[0-9]{3}$"
              },
              "rule_id": {
                "type": "string",
                "pattern": "^DQ-"
              },
              "category": {
                "type": "string"
              },
              "sql": {
                "type": "string",
                "minLength": 10
              },
              "expect": {
                "type": "string"
              },
              "actual": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "pass",
                  "fail",
                  "skip"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "passed",
            "failed",
            "skipped",
            "verdict"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "verdict": {
              "enum": [
                "pass",
                "fail",
                "pending"
              ]
            }
          }
        },
        "signoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed",
                "waived"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "waiver": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "expires_at"
              ],
              "description": "有条件放行：没有现网证据时，只能签 waived，且必须带到期日与跟进待办。",
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 10
                },
                "expires_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "followup_todo": {
                  "type": "string"
                },
                "approver": {
                  "type": "string"
                }
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
