{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dw.local/contracts/trial_run.schema.json",
  "title": "试跑质检报告（P3B / G3B）",
  "description": "监督者裁决之后、规则与血缘之前，把 final/ 脚本拿到可执行环境里真跑一遍：能连上、能解释、能执行、结果过得去。没有证据的试跑必须写 blocked，不许写 passed。",
  "type": "object",
  "required": ["run_id", "stage", "payload"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "enum": ["P3B"] },
    "payload": { "$ref": "#/definitions/payload" }
  },
  "additionalProperties": false,
  "definitions": {
    "payload": {
      "type": "object",
      "required": ["requirement_id", "generated_at", "environment", "scripts", "checks", "verdict"],
      "properties": {
        "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{8}-[0-9]{2}$" },
        "generated_at": { "type": "string", "minLength": 10 },
        "environment": {
          "type": "object",
          "required": ["mode", "engine", "target", "target_is_sandbox"],
          "properties": {
            "mode": { "type": "string", "enum": ["offline", "sandbox", "live"] },
            "engine": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "target_is_sandbox": { "type": "boolean" },
            "dt": { "type": "string" },
            "connected_at": { "type": "string" }
          },
          "additionalProperties": false
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "kind", "sha256", "status"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["ddl", "dml"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "status": { "type": "string", "enum": ["not_run", "explained", "executed", "failed"] },
              "rows_affected": { "type": "integer", "minimum": 0 },
              "error": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "category", "verdict"],
            "properties": {
              "id": { "type": "string", "pattern": "^T[0-9]{3}$" },
              "name": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "enum": ["structure", "executable", "quality", "reconcile"] },
              "sql": { "type": "string" },
              "expect": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "enum": ["zero_rows", "zero_value", "ratio_le", "min_rows", "equals"] },
                  "value": {}
                },
                "additionalProperties": false
              },
              "actual": {},
              "verdict": { "type": "string", "enum": ["pass", "fail", "skip", "blocked"] },
              "evidence": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "verdict": { "type": "string", "enum": ["passed", "failed", "blocked"] },
        "waiver": {
          "type": "object",
          "required": ["reason", "approved_by", "expires_at"],
          "properties": {
            "reason": { "type": "string", "minLength": 10 },
            "approved_by": { "type": "string", "minLength": 1 },
            "expires_at": { "type": "string", "minLength": 10 }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
