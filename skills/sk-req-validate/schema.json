{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sk-req-validate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc_path"],
  "properties": {
    "doc_path": {
      "type": "string",
      "pattern": "^requirements/需求分析员/[^/]+/REQ-\\d{8}-\\d{2}(-v\\d+)?\\.md$",
      "description": "翻译稿路径"
    },
    "registry_path": {
      "type": "string",
      "description": "可选，默认 requirements/反馈者/_registry.jsonl"
    }
  }
}
