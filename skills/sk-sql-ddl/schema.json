{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sk-sql-ddl input",
  "type": "object",
  "required": ["table_name", "comment", "columns", "partitioned_by"],
  "additionalProperties": false,
  "properties": {
    "table_name": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]*\\.)?[a-z][a-z0-9_]*$",
      "description": "库名.表名；库名可省略（由调度侧 USE 决定），但生产表契约里要求带库"
    },
    "comment": { "type": "string", "minLength": 4 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "comment"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": {
            "type": "string",
            "enum": ["string", "bigint", "int", "double", "decimal(18,2)", "boolean", "timestamp", "date", "map<string,string>", "array<string>"]
          },
          "comment": { "type": "string", "minLength": 2 }
        }
      }
    },
    "partitioned_by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["string", "int"] }
        }
      }
    },
    "stored_as": { "type": "string", "enum": ["ORC", "PARQUET", "TEXTFILE"], "default": "ORC" },
    "owner": { "type": "string" }
  }
}
