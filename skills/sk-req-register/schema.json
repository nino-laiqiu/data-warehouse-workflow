{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sk-req-register input",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "proposer", "channel", "submitted_at"],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^requirements/[^/]+/反馈者/REQ-\\d{8}-\\d{2}(-v\\d+)?\\.md$",
      "description": "原始需求文件路径，必须已存在于 <需求目录>/反馈者/ 下"
    },
    "proposer": { "type": "string", "minLength": 1, "description": "提出人；不许写'不详'" },
    "channel": { "type": "string", "minLength": 1, "description": "渠道：群名/邮件主题/会议名" },
    "submitted_at": { "type": "string", "minLength": 1, "description": "需求方提出时间，ISO8601 或 'YYYY-MM-DD HH:MM'" },
    "title": { "type": "string", "description": "可选，缺省取文件第一行标题" }
  }
}
