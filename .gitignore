# 运行产物不入库（示例 run 例外，作为双轨制的参考实现保留）
runs/*
!runs/.gitkeep
!runs/20261122-02/
!runs/20261122-02/**
.tmp/

# Python
__pycache__/
*.pyc

# 本机插件包（体积大，且是本地环境产物）
dsh-plugins/*.tgz
dsh-plugins/*/node_modules/

# 凭据永远不入库
.credentials*
*.pem
.env

# OS
.DS_Store
Thumbs.db
desktop.ini

# 本机 DSH 插件工程，不属于数仓项目
dsh-plugins/
