# 运行产物不入库：A 线的临时 run 放这里；B 线的产物在 requirements/需求开发员/<需求目录>/ 里，正常入库
runs/*
!runs/.gitkeep
# 巡检周报要入库：它是"上周 vs 本周"的对比基线，丢了就没法看趋势
!runs/inspection/
!runs/inspection/**
.tmp/

# Python
__pycache__/
*.pyc

# 本机插件包（体积大，且是本地环境产物）
dsh-plugins/*.tgz
dsh-plugins/*/.data/
node_modules/

# 凭据永远不入库
.credentials*
*.pem
.env

# OS
.DS_Store
Thumbs.db
desktop.ini

# 本机 DSH 插件工程，不属于数仓项目
dsh-plugins/

# 需求雷达的运行时状态（每个人本地各算各的，不入库）
需求池/_scan_state.json
需求池/_待确认.md

# 调度执行记录（与巡检报告一样，是趋势基线）
!runs/schedule/
!runs/schedule/**

# 问答沉淀的本地镜像（每台机器各自一份，不入库）
.data/
